# Runtime state: the remembered thread URL changes on every request, it is not source.
state.json

# Pre-fix backup of server.mjs, kept locally only as a safety net.
server.mjs.bak-*

node_modules/
*.log
systemd/meta-api.service.d/medicion.conf
pending-jobs.json
state.json

# Backups de estado que deja el propio servicio al arrancar
state.json.bak-*

# bridge runtime state (no versionar)
bridge/canal.json
bridge/vistos.json
bridge/*.log
bridge/don-bot-enviados.txt
bridge/msg-meta.txt
bridge/ignorar-meta.flag
engine/.auth.json
engine/.session.json

# Ajustes en caliente del panel + credenciales de la API (nunca versionar)
engine/.ajustes.json
engine/.api-keys.json
engine/.webchat-key
bridge/mirror-chat.txt
bridge/mirror-chat.jsonl

# Estado de runtime del motor protocol-first (no versionar)
engine/.conversations.json
engine/.conversations.json.bak

# Espejos de emulacion multicanal (runtime)
bridge/multichannel.txt
bridge/multichannel.jsonl
bridge/multichannel-resumen.json

# Imagenes generadas bajadas del CDN + espejo de eventos del motor
engine/.media/
bridge/engine-eventos.txt
bridge/engine-eventos.jsonl
engine/.run-state.json
engine/.rooms.json
engine/.usage.json

.venv-sandbox

# Salidas de runtime de bridge/: logs, espejos y volcados que escriben los
# scripts (no son fuente). Antes estaban versionados y arrastraban datos de
# conversacion dentro del repo.
bridge/agent-log.txt
bridge/dictado-log.txt
bridge/espejo-log.txt
bridge/espejo-msg.txt
bridge/msg-tecnica.txt
bridge/espejo-vistos.json
bridge/espejo-vistos-img.json
bridge/hilo-nuevo.json
bridge/turno.json
bridge/wsp-qr.png

# Estado del prompt editable: lo escribe el panel, es del usuario (no fuente).
engine/.prompt-ajustes.json

# Residuos locales: bytecode de Python y volcados de diagnostico.
__pycache__/
*.pyc
state/
