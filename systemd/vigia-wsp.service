[Unit]
Description=Vigia de WhatsApp — avisa al agente cuando el relay encola una invocacion Don Bot
Documentation=file:///home/test/test/meta-api/bridge/vigia-wsp.mjs
After=wsp.service network-online.target
Wants=wsp.service network-online.target

StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/bridge
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/bridge/vigia-wsp.mjs
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigia-wsp

[Install]
WantedBy=default.target
