[Unit]
Description=Salud del relay — levanta Chrome si CDP cae y reinicia wsp si deja de latir
Documentation=file:///home/test/test/meta-api/bridge/salud-relay.mjs
After=wsp.service meta-api.service
Wants=wsp.service meta-api.service

StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/bridge
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/bridge/salud-relay.mjs
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=salud-relay

[Install]
WantedBy=default.target
