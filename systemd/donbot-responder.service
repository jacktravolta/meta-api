[Unit]
Description=Responder Don Bot — compone y envia la respuesta a las invocaciones encoladas por el relay de WhatsApp
Documentation=file:///home/test/test/meta-api/relay/responder-donbot.mjs
# Detras de wsp.service: el relay es quien encola las invocaciones y quien
# finalmente envia la respuesta por CDP (R2).
After=wsp.service network-online.target
Wants=wsp.service network-online.target

# Un crash-loop no debe llenar el journal: 10 arranques en 5 min y se rinde.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api

# Node 22 de nvm: el del sistema es 18 y no tiene WebSocket global, que es lo
# que usa el cliente CDP de relay/wsp.mjs. Igual que wsp.service y meta-api.service.
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/relay/responder-donbot.mjs
# /home/test/.opencode/bin va al PATH porque ahi vive el binario `opencode`
# (composicion de la respuesta con el agente donbot). OPENCODE_BIN lo fija
# ademas sin depender del PATH.
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/home/test/.opencode/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
Environment=OPENCODE_BIN=/home/test/.opencode/bin/opencode
# El Chrome con WhatsApp logueado es el 9233; el default de wsp.mjs (9333) es
# OTRO Chrome sin sesion, por eso WSP_CDP es obligatorio (R2).
Environment=WSP_CDP=http://127.0.0.1:9233

# El consumidor es un loop infinito: solo debe reiniciarse si el proceso muere.
Restart=on-failure
RestartSec=5

# R4 — observable: stdout/stderr al journal (ademas del log propio en
# relay/state/donbot-responder.log).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=donbot-responder

[Install]
WantedBy=default.target
