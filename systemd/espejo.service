[Unit]
Description=Espejo Meta -> WhatsApp: relaya lo que responde Meta en su hilo al chat de WhatsApp
Documentation=file:///home/test/test/meta-api/bridge/espejo-meta-wsp.mjs
After=meta-api.service wsp.service network-online.target
Wants=meta-api.service wsp.service network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/bridge
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/bridge/espejo-meta-wsp.mjs
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
# El relay de WhatsApp comparte el mismo Chrome (CDP 9233).
Environment=WSP_CDP=http://127.0.0.1:9233
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=espejo

[Install]
WantedBy=default.target
