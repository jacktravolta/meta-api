[Unit]
Description=Vigia de dictado — detecta transcripciones nuevas en el hilo de Meta y las encola
Documentation=file:///home/test/test/meta-api/relay/vigia-v7.mjs
# El vigia NO arranca Chrome: se conecta por CDP al que levanta meta-api. Si
# meta-api no esta, el puerto 9233 no existe y el vigia queda reintentando en
# vano. Por eso depende de el, pero con Wants y no Requires: si meta-api se
# reinicia, el vigia se reconecta solo (tiene reconexion por ws.readyState).
After=meta-api.service network-online.target
Wants=meta-api.service network-online.target

# Un crash-loop no debe llenar el journal: 10 arranques en 5 minutos y se rinde.
# Esta clave va en [Unit]; en [Service] systemd la ignora en silencio.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/relay

# Node 22 de nvm, igual que meta-api: el node del sistema es 18 y NO tiene
# WebSocket global. Este script abre el socket CDP a mano, asi que sin
# WebSocket global muere al arrancar con "WebSocket is not defined".
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/relay/vigia-v7.mjs
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin

# El estado runtime vive en relay/state/ (gitignored). Se deja explicito para
# que el vigia no escriba en el directorio temporal, que el reboot borra --
# que es exactamente por lo que este relay se movio de /tmp al repo.
Environment=HOME=/home/test

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigia

[Install]
WantedBy=default.target
