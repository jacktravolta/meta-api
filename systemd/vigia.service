[Unit]
Description=Vigia del hilo de Meta — detecta dictados "Don Bot" y avisa al agente
Documentation=file:///home/test/test/meta-api/bridge/vigia.mjs
After=meta-api.service network-online.target
Wants=meta-api.service network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/bridge
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/bridge/vigia.mjs
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigia

[Install]
WantedBy=default.target
