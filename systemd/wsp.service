[Unit]
Description=Puente de WhatsApp — detecta invocaciones Don Bot en WhatsApp Web y responde
Documentation=file:///home/test/test/meta-api/relay/wsp.mjs
# Unificado: usa el MISMO Chrome que meta-api (perfil google-chrome-beta-debug,
# CDP 9233, headless). Ya no arranca un Chrome propio ni abre ventana.
After=meta-api.service network-online.target
Wants=meta-api.service network-online.target

# Un crash-loop no debe llenar el journal: 10 arranques en 5 min y se rinde.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/relay

# Node 22 de nvm: el del sistema es 18 y no tiene WebSocket global, que es
# justo lo que usa el cliente CDP.
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/relay/wsp.mjs --responder
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
# Mismo Chrome que el hilo de Meta (pestaña aparte, mismo perfil).
Environment=WSP_CDP=http://127.0.0.1:9233
# El cerebro es Meta AI via meta-api (/v1/chat/completions): el relay solo
# transporta. Modo agente (WSP_AGENTE=1) desactivado a proposito.

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wsp

[Install]
WantedBy=default.target
