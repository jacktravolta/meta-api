[Unit]
Description=Escucha de errores de la consola de Meta (diagnostico del crash del SPA)
Documentation=file:///home/test/test/meta-api/bridge/escuchar-errores-meta.mjs
After=meta-api.service
Wants=meta-api.service

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/test/test/meta-api/bridge
ExecStart=/home/test/.nvm/versions/node/v22.23.3/bin/node /home/test/test/meta-api/bridge/escuchar-errores-meta.mjs
Environment=PATH=/home/test/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/test
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=errores-meta

[Install]
WantedBy=default.target
